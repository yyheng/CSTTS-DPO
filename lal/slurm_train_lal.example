#!/usr/bin/env bash
#SBATCH --job-name=whisper_lal
#SBATCH --gres=gpu:1
# Legacy one-GPU Whisper-LAL training job. Submit from the repository root through the site wrapper
# (`slurm/sb lal/slurm_train_lal.example`), which adds partition / exclude / account / output from
# config/paths.env and exports every CMI_DPO_* variable (CMI_DPO_DATA_ROOT = dir with the SEAME Kaldi dirs).
PKG=${CMI_DPO_PKG:?run through slurm/sb}
source "$PKG/slurm/load_env.sh"   # CMI_DPO_* already in the environment win over the file
source "$CMI_DPO_CONDA_SH"
conda activate "$CMI_DPO_ENV_LAL"
cd "$PKG/lal"

python3 train_whisper_LAL.py --train "$CMI_DPO_DATA_ROOT/train" --dev "$CMI_DPO_DATA_ROOT/valid" \
    --devman "$CMI_DPO_DATA_ROOT/devman" --devsge "$CMI_DPO_DATA_ROOT/devsge" --model openai/whisper-small
