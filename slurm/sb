#!/bin/bash
# ---------------------------------------------------------------------------
# slurm/sb : site-agnostic sbatch wrapper (login-node safe: bash + sbatch only).
#
#   usage: slurm/sb <file.sbatch> [extra sbatch args...]
#   e.g.   slurm/sb slurm/gen.sbatch --export=ALL,SHARD=0,NSHARDS=4
#          slurm/sb slurm/dpo.sbatch --gres=gpu:4 --export=ALL,GPUS=4
#          slurm/sb slurm/prep.sbatch --test-only          (validate, submit nothing)
#
# The .sbatch files carry no site-specific #SBATCH lines (partition / exclude / account / output).
# This wrapper derives the package root PKG from its own location, loads PKG/config/paths.env
# through slurm/load_env.sh (KEY=VALUE lines, prefix CMI_DPO_; a CMI_DPO_* variable already set in
# the calling shell wins over the file, as in cmi_dpo/paths.py) and submits
#   sbatch --partition=$CMI_DPO_SLURM_PARTITION [--exclude=$CMI_DPO_SLURM_EXCLUDE]
#          [--account=$CMI_DPO_SLURM_ACCOUNT] $CMI_DPO_SLURM_EXTRA
#          --output=$PKG/logs/%x_%j.out --export=ALL,CMI_DPO_PKG=$PKG  <extra args>  <file.sbatch>
# The extra args are placed BEFORE the script (sbatch treats words after the script as script
# arguments), so they are real sbatch options and override both the #SBATCH directives and the
# options above (last occurrence wins): --gres / --time / --job-name / --dependency / --export ...
# CMI_DPO_PKG (and every CMI_DPO_* value) is also exported into this shell, so a caller-supplied
# --export=ALL,... still forwards it; only --export without ALL would drop it.
# The job body then starts with  PKG=${CMI_DPO_PKG:?run through slurm/sb}  and re-loads
# $PKG/config/paths.env the same way (values forwarded by --export=ALL are kept).
# ---------------------------------------------------------------------------
set -euo pipefail

usage() { echo "usage: slurm/sb <file.sbatch> [extra sbatch args...]" >&2; exit 2; }
[[ $# -ge 1 ]] || usage
case "$1" in -h|--help) usage ;; esac
script=$1; shift
[[ -f "$script" ]] || { echo "sb: sbatch file not found: $script" >&2; exit 2; }

PKG=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
ENV_FILE=$PKG/config/paths.env
if [[ ! -f "$ENV_FILE" ]]; then
  echo "sb: $ENV_FILE not found; copy $PKG/config/paths.env.example to it and fill in your paths" >&2
  exit 2
fi
# shellcheck disable=SC1091
source "$PKG/slurm/load_env.sh"   # CMI_DPO_* already in the environment win over the file
export CMI_DPO_PKG=$PKG
: "${CMI_DPO_SLURM_PARTITION:?sb: set CMI_DPO_SLURM_PARTITION in $ENV_FILE}"

mkdir -p "$PKG/logs"
opts=(--partition="$CMI_DPO_SLURM_PARTITION")
[[ -n "${CMI_DPO_SLURM_EXCLUDE:-}" ]] && opts+=(--exclude="$CMI_DPO_SLURM_EXCLUDE")
[[ -n "${CMI_DPO_SLURM_ACCOUNT:-}" ]] && opts+=(--account="$CMI_DPO_SLURM_ACCOUNT")
# CMI_DPO_SLURM_EXTRA holds verbatim sbatch options (word-split on purpose), e.g. "--qos=gpu --constraint=a40"
# shellcheck disable=SC2206
[[ -n "${CMI_DPO_SLURM_EXTRA:-}" ]] && opts+=(${CMI_DPO_SLURM_EXTRA})
opts+=(--output="$PKG/logs/%x_%j.out" --export=ALL,CMI_DPO_PKG="$PKG")

exec sbatch "${opts[@]}" "$@" "$script"
