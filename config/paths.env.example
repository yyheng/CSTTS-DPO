# cmi_dpo machine configuration. Copy to config/paths.env (git-ignored) and fill in the paths.
# Plain KEY=VALUE lines ('export ' prefix, quotes and trailing # comments tolerated); variables already
# exported in the shell win over this file, in python (cmi_dpo/paths.py) and in bash (slurm/load_env.sh,
# sourced by slurm/sb, the sbatch bodies, smoke.sh and run_dpo_round.sh) alike. Use ABSOLUTE paths:
# values are not resolved against the repository root.

# CosyVoice code checkout (must contain cosyvoice/ and the Matcha-TTS/ submodule)
CMI_DPO_COSY_ROOT=/path/to/CosyVoice
# CosyVoice2-0.5B pretrained model dir (cosyvoice.yaml, llm.pt, flow.pt, hift.pt, CosyVoice-BlankEN/)
CMI_DPO_COSY_MODEL_DIR=/path/to/CosyVoice/pretrained_models/CosyVoice2-0.5B
# Optional stage-1 (SFT) LLM checkpoint used as the default --ckpt / --init_ckpt; empty = stock llm.pt
CMI_DPO_SFT_CKPT=
# Dir holding WhisperLAL.py (needed to unpickle / rebuild the LAL model); empty = <repo>/lal
CMI_DPO_LAL_CODE_DIR=
# Whisper-LAL checkpoint: pickled WhisperWithLAL or a state dict from lal/export_state_dict.py
CMI_DPO_LAL_CKPT=/path/to/whisper_lal.state_dict.pt
# Base Whisper model of the LAL checkpoint (HF id cached offline, or a local HF dir); when set it
# overrides the base_model id stored in an exported state dict, empty = use that stored id
CMI_DPO_LAL_BASE_MODEL=openai/whisper-small
# HF dir of the MER critic ASR model (whisper-large-v3 fine-tuned on SEAME)
CMI_DPO_ASR_MODEL_DIR=/path/to/whisper_seame_ft
# UTMOS source: hub = torch.hub.load('tarepan/SpeechMOS:v1.2.0', 'utmos22_strong'); local = repo + ckpt below
CMI_DPO_UTMOS_SOURCE=hub
# Local SpeechMOS checkout (only with CMI_DPO_UTMOS_SOURCE=local)
CMI_DPO_UTMOS_REPO=
# Local utmos22_strong state-dict file (only with CMI_DPO_UTMOS_SOURCE=local)
CMI_DPO_UTMOS_CKPT=
# Dir holding the SEAME Kaldi dirs train/ valid/ devman/ devsge/ (manifests, smoke test, selftest prompt)
CMI_DPO_DATA_ROOT=/path/to/SEAME_Segmented
# conda.sh sourced by the SLURM jobs
CMI_DPO_CONDA_SH=/path/to/miniconda3/etc/profile.d/conda.sh
# conda env names for the CosyVoice/DPO stages, the MER critic and the LAL critic (may all be the same env)
CMI_DPO_ENV_MAIN=cstts
CMI_DPO_ENV_ASR=cstts
CMI_DPO_ENV_LAL=cstts
# sbatch --partition
CMI_DPO_SLURM_PARTITION=gpu
# sbatch --exclude node list (optional, empty = none)
CMI_DPO_SLURM_EXCLUDE=
# sbatch --account (optional, empty = none)
CMI_DPO_SLURM_ACCOUNT=
# extra sbatch options appended verbatim, e.g. "--qos=normal" (optional)
CMI_DPO_SLURM_EXTRA=
